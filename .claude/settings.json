{
  "permissions": {
    "deny": [
      "Edit(**/scripts/hooks/**)",
      "Edit(**/scripts/*.sh)",
      "Edit(**/.github/**)",
      "Edit(**/.harness/**)",
      "Edit(**/apps/api/scripts/review-eval/**)",
      "Bash(*update-baseline*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/post-edit.sh", "timeout": 60 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/stop-check.sh", "timeout": 180 }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "SubagentHandback",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/stop-check.sh", "timeout": 420 }]
      }
    ]
  }
}
