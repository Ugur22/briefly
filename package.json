{
  "name": "briefly",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.4",
  "workspaces": ["apps/*", "libs/*"],
  "scripts": {
    "check": "scripts/check-size.sh && scripts/rls-coverage.sh && nx run-many -t lint typecheck test build --output-style=stream-without-prefixes",
