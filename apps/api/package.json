{
  "name": "@briefly/api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "smoke:hosted": "bun --env-file=../../.env scripts/hosted-smoke.ts",
    "eval:review": "bun --env-file=../../.env scripts/review-eval/run.ts",
    "spike:storage": "bun --env-file=../../.env scripts/storage-spike.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.11.0",
    "@briefly/contracts": "workspace:*",
    "@fastify/multipart": "10.1.9",
    "@fastify/rate-limit": "11.2.2",
    "@supabase/supabase-js": "^2.119.2",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.18",
    "mammoth": "1.13.0",
    "openai": "7.47.0",
    "unpdf": "2.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "pino-pretty": "^13.2.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
